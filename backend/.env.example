# LLM Provider: "llama_cpp" | "ollama" | "vllm" | "deepseek"
LLM_PROVIDER=llama_cpp
DEV_QUICK_LOGIN_ENABLED=false

# llama.cpp in Ubuntu WSL Docker (Qwen2.5 1.5B GGUF Q4_K_M, one served model)
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_LARGE_MODEL=persona-qwen
LOCAL_LLM_SMALL_MODEL=persona-qwen
LOCAL_LLM_MAX_TOKENS=512
 
# Ollama is retained for CPU-only Nomic embeddings, not chat.
# Local dev: http://localhost:11435
# Docker:    http://ollama:11434  (override tự động bởi docker-compose.yml)
OLLAMA_HOST=http://localhost:11435
OLLAMA_MODEL=llama3.2:3b
OLLAMA_LARGE_MODEL=llama3.2:3b
OLLAMA_SMALL_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=30m
ROUTER_ENABLED=true
WARMUP_ON_STARTUP=true
# false = backend nhận kết nối ngay, warm-up chạy nền; true = đợi warm-up xong mới ready
WARMUP_BLOCKING=false
WARMUP_TIMEOUT_SECONDS=180

# DeepSeek configuration (dùng khi LLM_PROVIDER=deepseek)
# Lấy API key tại: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ElevenLabs TTS (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# pcm_44100 = raw PCM 16-bit — được wrap thành WAV tự động, Rhubarb đọc được
# mp3_44100_128 = MP3 (không dùng được với Rhubarb nếu không có ffmpeg)
ELEVENLABS_OUTPUT_FORMAT=pcm_44100
# Local XTTS fallback: nếu ElevenLabs lỗi hoặc không load được, backend sẽ dùng
# model local này thay thế. Cần file giọng mẫu .wav.
XTTS_SPEAKER_WAV=
XTTS_LANGUAGE=vi
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# Self-hosted Kokoro CPU TTS. Compose selects this provider automatically.
TTS_PROVIDER=chatterbox-nano
KOKORO_TTS_URL=http://localhost:8880/synthesize
KOKORO_TTS_TIMEOUT_SECONDS=60

# English voice cloning on CPU; Kokoro remains the preset/failure fallback.
# Set TTS_PROVIDER=kokoro for preset voices only.
CHATTERBOX_TTS_URL=http://localhost:8881/synthesize
CHATTERBOX_TTS_TIMEOUT_SECONDS=90
VOICE_MAX_FILE_MB=10

# Custom GCP TTS (optional deployed model)
GCP_CUSTOM_TTS_URL=
GCP_CUSTOM_TTS_API_KEY=

# Speech-to-Text (mic input Stage 3)
# PyAV decodes browser recordings directly; no system ffmpeg is needed.
# CPU/int8 leaves GPU memory available for vLLM. Empty STT_LANGUAGE auto-detects.
STT_ENABLED=false
STT_PROVIDER=faster-whisper
STT_MODEL=base
STT_LANGUAGE=vi
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MAX_FILE_MB=10
STT_MAX_DURATION_SECONDS=60

# Rhubarb Lip Sync (Stage 4 — chính xác nhất, optional)
# Download: https://github.com/DanielSWolf/rhubarb-lip-sync/releases
# Windows: RHUBARB_PATH=./rhubarb/rhubarb.exe
# Để trống → fallback sang amplitude-based lip-sync (jawOpen theo RMS audio)
RHUBARB_PATH=

# Server configuration
HOST=0.0.0.0
PORT=8001
RELOAD=false

# Logging
LOG_LEVEL=INFO

# Stage 7 production hardening
# Authentication is always required: register/login via /api/auth/*, then pass
# Bearer token / WS ?token=... so backend derives user_id from auth, not payload.
AUTH_TOKEN_SECRET=change-me-dev-secret
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_DEV_USER_ID=dev_user
MAX_WS_MESSAGE_BYTES=32768
MAX_REST_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_RATE_LIMIT_MESSAGES=60
WS_RATE_LIMIT_WINDOW_SECONDS=60
SESSION_BACKEND=file
SESSION_HISTORY_PATH=./data/session_history
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@postgres:5432/chatbot
DATABASE_AUTO_CREATE=true

# Character Persona (fallback khi character_id không có trong registry)
CHARACTER_NAME=Aria
CHARACTER_BACKSTORY="I am a warm and empathetic AI companion."
CHARACTER_PERSONALITY="curious, caring, gently playful"

# Multi-character roleplay — character brain (docs/characters/*.md + characters.json)
DEFAULT_CHARACTER_ID=luna
LORE_DATA_PATH=./lore_data
LORE_TOP_K=4
LORE_CHUNK_THRESHOLD_WORDS=3000
LORE_CHUNK_SIZE_CHARS=1500
LORE_CHUNK_OVERLAP_CHARS=200

# Embedding — deliberately separate from LLM_PROVIDER (see
# docs/MODEL_MANAGEMENT_PLAN.md §2.12). Changing LLM_PROVIDER (e.g. ollama ->
# gemini) does NOT change which embedding model is used for Chroma memory and
# character lore search — you must change EMBEDDING_PROVIDER explicitly.
# WARNING: changing EMBEDDING_PROVIDER or EMBEDDING_MODEL after data has
# already been embedded makes existing Chroma vectors unsearchable (different
# vector space, no error raised) — re-ingest chat_memories / character lore
# after changing either value.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Memory optimization
# true = skip expensive turn retrieval for trivial small-talk while still storing turns
# and still loading structured facts through metadata.
MEMORY_FAST_PATH_ENABLED=true
MEMORY_RRF_K=60
MEMORY_DENSE_WEIGHT=1.0
MEMORY_SPARSE_WEIGHT=1.5
MEMORY_DENSE_OVERFETCH_MULTIPLIER=2

# LangSmith Observability (optional — đặt false để tắt)
# Current SDKs prefer LANGSMITH_*; legacy LANGCHAIN_* aliases are kept for compatibility.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interactive-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=${LANGSMITH_TRACING}
LANGCHAIN_API_KEY=${LANGSMITH_API_KEY}
LANGCHAIN_PROJECT=${LANGSMITH_PROJECT}
LANGCHAIN_ENDPOINT=${LANGSMITH_ENDPOINT}
# Chỉ cần khi LANGSMITH_API_KEY là "Service Key" (tiền tố lsv2_sk_...) tạo ở cấp
# organization thay vì "Personal Access Token" (lsv2_pt_...). Service key org-scoped
# không tự biết ghi trace vào workspace nào — thiếu biến này thì mọi request bị
# 403 "org_scoped_key_requires_workspace". Lấy ID tại Settings > Workspaces trên
# LangSmith. Personal Access Token thì để trống, không cần biến này.
LANGSMITH_WORKSPACE_ID=

# Google OAuth Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


LOCAL_LLM_MAX_TOKENS=512
